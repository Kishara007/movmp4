---
import en from '../i18n/locales/en.json';
---

<footer
  class="mt-16 border-t py-8 sm:py-10"
  style="border-color: var(--border-main); background-color: var(--bg-card);"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="space-y-1.5">
      <a href="/" class="text-base font-bold tracking-tight hover:opacity-80" data-i18n="nav.brand">
        {en.nav.brand}
      </a>
      <p class="text-sm" style="color: var(--text-muted);" data-i18n="footer.tagline">
        {en.footer.tagline}
      </p>
      <p class="text-xs" style="color: var(--text-muted);">
        <span data-i18n="footer.builtBy">{en.footer.builtBy}</span>
        <span aria-hidden="true"> • </span>
        <span data-i18n="footer.rights">{en.footer.rights}</span>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
      <a href="/how-to-use" class="hover:underline underline-offset-4" data-i18n="nav.howToUse">
        {en.nav.howToUse}
      </a>
      <a href="/hire-me" class="hover:underline underline-offset-4" data-i18n="nav.hireMe">
        {en.nav.hireMe}
      </a>
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline underline-offset-4"
        data-i18n="nav.support"
      >
        {en.nav.support}
      </a>
      <a
        href="https://github.com/Kishara007/movmp4"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline underline-offset-4"
      >
        GitHub
      </a>
      <a
        href="mailto:kisharadilshan007@gmail.com"
        class="hover:underline underline-offset-4"
      >
        kisharadilshan007@gmail.com
      </a>
    </div>
  </div>
</footer>
