---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmailButton from '../components/CopyEmailButton';
import en from '../i18n/locales/en.json';

const canonicalUrl = 'https://movmp4.pages.dev/hire-me';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://movmp4.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Hire Me',
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={en.meta.hireMeTitle}
  description={en.meta.hireMeDescription}
  titleKey="meta.hireMeTitle"
  descKey="meta.hireMeDescription"
  canonicalUrl={canonicalUrl}
  currentPath="/hire-me"
  jsonLd={breadcrumbSchema}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Semantic Breadcrumbs (subpages only) -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm font-medium" style="color: var(--text-muted);">
        <li>
          <a href="/" class="hover:underline underline-offset-4" style="color: var(--text-primary);" data-i18n="hireMe.breadcrumbHome">
            {en.hireMe.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" data-i18n="hireMe.breadcrumbCurrent">
          {en.hireMe.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <div
      class="rounded-3xl border p-6 sm:p-10 shadow-sm space-y-8"
      style="background-color: var(--bg-card); border-color: var(--border-main);"
    >
      <header class="space-y-4">
        <span
          class="inline-flex items-center rounded-full border px-3.5 py-1 text-xs sm:text-sm font-bold"
          style="background-color: var(--accent-mist); border-color: var(--border-main); color: #231F1E;"
          data-i18n="hireMe.badge"
        >
          {en.hireMe.badge}
        </span>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight" data-i18n="hireMe.h1">
          {en.hireMe.h1}
        </h1>

        <p class="text-lg sm:text-xl font-semibold" data-i18n="hireMe.intro">
          {en.hireMe.intro}
        </p>

        <p class="text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="hireMe.body">
          {en.hireMe.body}
        </p>
      </header>

      <!-- 3 Specialization Cards -->
      <section aria-label="Specializations" class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <div
          class="rounded-2xl border p-5 flex flex-col justify-between"
          style="background-color: var(--bg-subtle); border-color: var(--border-main);"
        >
          <div>
            <h2 class="text-base sm:text-lg font-bold leading-snug" data-i18n="hireMe.spec1Title">
              {en.hireMe.spec1Title}
            </h2>
            <p
              class="mt-2 inline-block rounded-lg px-2.5 py-1 text-xs font-bold"
              style="background-color: var(--accent-mist); color: #231F1E;"
              data-i18n="hireMe.spec1Sub"
            >
              {en.hireMe.spec1Sub}
            </p>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-muted);" data-i18n="hireMe.spec1Desc">
              {en.hireMe.spec1Desc}
            </p>
          </div>
        </div>

        <div
          class="rounded-2xl border p-5 flex flex-col justify-between"
          style="background-color: var(--bg-subtle); border-color: var(--border-main);"
        >
          <div>
            <h2 class="text-base sm:text-lg font-bold leading-snug" data-i18n="hireMe.spec2Title">
              {en.hireMe.spec2Title}
            </h2>
            <p
              class="mt-2 inline-block rounded-lg px-2.5 py-1 text-xs font-bold"
              style="background-color: var(--accent-mist); color: #231F1E;"
              data-i18n="hireMe.spec2Sub"
            >
              {en.hireMe.spec2Sub}
            </p>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-muted);" data-i18n="hireMe.spec2Desc">
              {en.hireMe.spec2Desc}
            </p>
          </div>
        </div>

        <div
          class="rounded-2xl border p-5 flex flex-col justify-between"
          style="background-color: var(--bg-subtle); border-color: var(--border-main);"
        >
          <div>
            <h2 class="text-base sm:text-lg font-bold leading-snug" data-i18n="hireMe.spec3Title">
              {en.hireMe.spec3Title}
            </h2>
            <p
              class="mt-2 inline-block rounded-lg px-2.5 py-1 text-xs font-bold"
              style="background-color: var(--accent-mist); color: #231F1E;"
              data-i18n="hireMe.spec3Sub"
            >
              {en.hireMe.spec3Sub}
            </p>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-muted);" data-i18n="hireMe.spec3Desc">
              {en.hireMe.spec3Desc}
            </p>
          </div>
        </div>
      </section>

      <!-- Closing & Contact Actions -->
      <footer class="pt-4 border-t space-y-4" style="border-color: var(--border-main);">
        <p class="text-lg font-bold" data-i18n="hireMe.closing">
          {en.hireMe.closing}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="mailto:kisharadilshan007@gmail.com"
            class="inline-flex min-h-[48px] items-center justify-center rounded-2xl px-6 py-3 text-sm sm:text-base font-bold shadow-sm transition-opacity hover:opacity-90"
            style="background-color: var(--action-primary); color: var(--action-primary-text);"
            data-i18n="hireMe.emailButton"
          >
            {en.hireMe.emailButton}
          </a>

          <CopyEmailButton client:load />

          <a
            href="mailto:kisharadilshan007@gmail.com"
            class="text-sm sm:text-base font-semibold underline underline-offset-4 px-2 py-2"
            style="color: var(--text-muted);"
          >
            kisharadilshan007@gmail.com
          </a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
