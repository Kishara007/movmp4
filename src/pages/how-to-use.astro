---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/locales/en.json';

const canonicalUrl = 'https://movmp4.pages.dev/how-to-use';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://movmp4.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'How to Use',
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={en.meta.howToUseTitle}
  description={en.meta.howToUseDescription}
  titleKey="meta.howToUseTitle"
  descKey="meta.howToUseDescription"
  canonicalUrl={canonicalUrl}
  currentPath="/how-to-use"
  jsonLd={breadcrumbSchema}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Semantic Breadcrumbs (subpages only) -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm font-medium" style="color: var(--text-muted);">
        <li>
          <a href="/" class="hover:underline underline-offset-4" style="color: var(--text-primary);" data-i18n="howToUse.breadcrumbHome">
            {en.howToUse.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" data-i18n="howToUse.breadcrumbCurrent">
          {en.howToUse.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <header class="space-y-4 mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight" data-i18n="howToUse.h1">
        {en.howToUse.h1}
      </h1>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.intro">
        {en.howToUse.intro}
      </p>
    </header>

    <div class="space-y-6">
      <section
        class="rounded-3xl border p-6 sm:p-8"
        style="background-color: var(--bg-card); border-color: var(--border-main);"
      >
        <h2 class="text-xl sm:text-2xl font-bold" data-i18n="howToUse.step1Heading">
          {en.howToUse.step1Heading}
        </h2>
        <p class="mt-3 text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.step1Body">
          {en.howToUse.step1Body}
        </p>
      </section>

      <section
        class="rounded-3xl border p-6 sm:p-8"
        style="background-color: var(--bg-card); border-color: var(--border-main);"
      >
        <h2 class="text-xl sm:text-2xl font-bold" data-i18n="howToUse.step2Heading">
          {en.howToUse.step2Heading}
        </h2>
        <p class="mt-3 text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.step2Body">
          {en.howToUse.step2Body}
        </p>
      </section>

      <section
        class="rounded-3xl border p-6 sm:p-8"
        style="background-color: var(--bg-card); border-color: var(--border-main);"
      >
        <h2 class="text-xl sm:text-2xl font-bold" data-i18n="howToUse.step3Heading">
          {en.howToUse.step3Heading}
        </h2>
        <p class="mt-3 text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.step3Body">
          {en.howToUse.step3Body}
        </p>
      </section>
    </div>

    <section class="mt-12 space-y-6" aria-labelledby="use-cases-heading">
      <h2 id="use-cases-heading" class="text-2xl sm:text-3xl font-bold tracking-tight" data-i18n="howToUse.useCasesHeading">
        {en.howToUse.useCasesHeading}
      </h2>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <article
          class="rounded-2xl border p-6"
          style="background-color: var(--bg-card); border-color: var(--border-main);"
        >
          <h3 class="text-lg font-bold" data-i18n="howToUse.useCase1Title">{en.howToUse.useCase1Title}</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.useCase1Body">
            {en.howToUse.useCase1Body}
          </p>
        </article>
        <article
          class="rounded-2xl border p-6"
          style="background-color: var(--bg-card); border-color: var(--border-main);"
        >
          <h3 class="text-lg font-bold" data-i18n="howToUse.useCase2Title">{en.howToUse.useCase2Title}</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.useCase2Body">
            {en.howToUse.useCase2Body}
          </p>
        </article>
        <article
          class="rounded-2xl border p-6"
          style="background-color: var(--bg-card); border-color: var(--border-main);"
        >
          <h3 class="text-lg font-bold" data-i18n="howToUse.useCase3Title">{en.howToUse.useCase3Title}</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);" data-i18n="howToUse.useCase3Body">
            {en.howToUse.useCase3Body}
          </p>
        </article>
      </div>
    </section>

    <div class="mt-10">
      <a
        href="/"
        class="inline-flex min-h-[50px] items-center justify-center rounded-2xl px-7 py-3 text-base font-bold shadow-sm transition-opacity hover:opacity-90"
        style="background-color: var(--action-primary); color: var(--action-primary-text);"
        data-i18n="howToUse.ctaButton"
      >
        {en.howToUse.ctaButton}
      </a>
    </div>
  </article>
</BaseLayout>
